@{
    ViewData["Title"] = "Dashboard";
}

<div class="row">
    <div class="col-12">
        <h2 class="mb-4"><i class="bi bi-speedometer2 me-2"></i>Dashboard</h2>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card text-white bg-primary shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title">Departamentos</h5>
                        <h2 class="display-4">3</h2>
                    </div>
                    <i class="bi bi-building fs-1 opacity-50"></i>
                </div>
                <a asp-controller="Departamento" asp-action="Index" class="btn btn-light btn-sm mt-2">
                    Ver todos <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-success shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title">Empleados</h5>
                        <h2 class="display-4">5</h2>
                    </div>
                    <i class="bi bi-people fs-1 opacity-50"></i>
                </div>
                <a asp-controller="Empleadoes" asp-action="Index" class="btn btn-light btn-sm mt-2">
                    Ver todos <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>