@model Empleado

@{
    ViewData["Title"] = "Detalles del Empleado";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0"><i class="bi bi-eye me-2"></i>Detalles del Empleado</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Código</dt>
                    <dd class="col-sm-8"><strong>@Model.EmpleadoId</strong></dd>
                    
                    <dt class="col-sm-4">Nombre</dt>
                    <dd class="col-sm-8"><strong>@Model.Nombre</strong></dd>
                    
                    <dt class="col-sm-4">Fecha de Nacimiento</dt>
                    <dd class="col-sm-8">@Model.FechaNacimiento.ToShortDateString()</dd>
                    
                    <dt class="col-sm-4">Fecha de Contratación</dt>
                    <dd class="col-sm-8">@Model.FechaContratacion.ToShortDateString()</dd>
                    
                    <dt class="col-sm-4">Departamento</dt>
                    <dd class="col-sm-8"><span class="badge bg-info">@Model.Departamento?.Nombre</span></dd>
                    
                    <dt class="col-sm-4">Salario</dt>
                    <dd class="col-sm-8"><strong>$@Model.Salario.ToString("N0")</strong></dd>
                    
                    <dt class="col-sm-4">Descripción</dt>
                    <dd class="col-sm-8">@Model.Descripcion</dd>
                </dl>

                <div class="mt-3">
                    <a asp-action="Edit" asp-route-id="@Model.EmpleadoId" class="btn btn-warning">
                        <i class="bi bi-pencil me-1"></i>Editar
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Volver
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>